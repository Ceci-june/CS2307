# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=real_estate

HOST_DB=postgres
PORT_DB=5432
USERNAME_DB=postgres
PASSWORD_DB=changeme
DATABASE=real_estate
# Optional full URL used by Alembic instead of the five variables above.
# DATABASE_URL=postgresql+psycopg2://postgres:changeme@postgres:5432/real_estate

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_END_POINT=minio:9000
MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=changeme
MINIO_BUCKET_NAME=property-images
MINIO_SECURE=False

# Neo4j
NEO4J_AUTH=neo4j/changeme
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# App
DEBUG=True
VERSION=1.0.0
PROJECT_NAME=real-estate-recommendation-system

# Gemini
GEMINI_API_KEYS=

# Hybrid search (PostgreSQL FTS + pgvector + optional Neo4j graph retrieval)
SEARCH_EMBEDDING_MODEL=intfloat/multilingual-e5-large
# auto = CUDA -> Apple MPS -> CPU. Also accepts cpu, cuda, cuda:0, mps.
SEARCH_EMBEDDING_DEVICE=auto
SEARCH_ALLOW_MODEL_DOWNLOAD=false
SEARCH_USE_LLM_PARSER=false
SEARCH_USE_NEO4J=true
BACKEND_URL=http://127.0.0.1:8001

# LLM tuỳ chọn cho gen_user_data (sinh raw_query/persona/description).
# Mặc định TẮT -> pipeline chạy offline bằng template + RNG.
USE_LLM=0
LLM_PROVIDER=groq                 # groq | grok | openai (đều tương thích API OpenAI)
GROQ_API_KEY=                     # lấy tại https://console.groq.com/keys
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=                   # ghi đè nếu dùng endpoint khác
# LLM_TEMPERATURE=0.8
# LLM_MAX_LISTINGS_DESC=150       # số listing sinh description (0 = tắt)

# Auth
ACCESS_TOKEN_SECRET_KEY=changeme
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_SECRET_KEY=changeme
REFRESH_TOKEN_EXPIRE_MINUTES=10080
